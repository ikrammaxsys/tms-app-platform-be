<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>tms_template_net8</RootNamespace>
    <!-- API-only: no Razor/static wwwroot bundle required at startup -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Emit XML docs so Swagger can surface the API's summary comments. 1591 = missing XML comment. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TMS.WebApp.Sdk" Version="0.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="templates\**\*.cs" />
    <Content Remove="templates\**" />
  </ItemGroup>

</Project>
