@model tms_template_net8.Models.ViewModels.DataTableViewModel
@functions {
    static string Cell(Dictionary<string, object?> row, string key)
        => row != null && row.TryGetValue(key, out var v) && v != null ? v.ToString()! : string.Empty;

    static string StatusClass(string status)
    {
        switch ((status ?? string.Empty).Trim().ToLowerInvariant())
        {
            case "healthy":
            case "operational":
            case "active":
            case "live":
            case "online":
            case "success":
            case "up":
            case "enabled":
                return "is-green";
            case "warning":
            case "degraded":
            case "partial":
            case "pending":
            case "maintenance":
                return "is-amber";
            case "down":
            case "offline":
            case "critical":
            case "error":
            case "failed":
                return "is-red";
            case "info":
            case "new":
                return "is-blue";
            default:
                return "is-gray";
        }
    }
}
<div class="tms-dt" id="@(Model.Id)-wrap"
     data-page-length="@Model.PageLength"
     data-row-redirect="@(Model.RowClickRedirect ? "true" : "false")"
     data-route-template="@(string.IsNullOrEmpty(Model.RouteTemplate) ? "" : Url.Content(Model.RouteTemplate))">
    @if (Model.Searching)
    {
        <div class="tms-dt-toolbar">
            <div class="tms-dt-search-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="search" class="tms-dt-search" placeholder="Search..." aria-label="Search table" />
            </div>
        </div>
    }
    <div class="tms-dt-table-wrap">
        <table class="tms-dt-table" id="@Model.Id">
            <thead>
                <tr>
                    @if (Model.IncludeCheckbox)
                    {
                        <th class="tms-dt-check-col"><input type="checkbox" class="tms-dt-check-all" aria-label="Select all rows" /></th>
                    }
                    @foreach (var col in Model.Columns)
                    {
                        <th data-key="@col.Data" data-orderable="@(col.Orderable ? "true" : "false")"
                            style="@(string.IsNullOrEmpty(col.Width) ? "" : $"width:{col.Width}")">
                            <span class="tms-dt-th-label">@col.Title</span>
                            @if (col.Orderable)
                            {
                                <span class="tms-dt-sort"></span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var idVal = Cell(row, Model.IdField);
                    <tr data-id="@idVal">
                        @if (Model.IncludeCheckbox)
                        {
                            <td class="tms-dt-check-col"><input type="checkbox" class="tms-dt-check-row" value="@idVal" aria-label="Select row" /></td>
                        }
                        @foreach (var col in Model.Columns)
                        {
                            var text = Cell(row, col.Data);
                            <td data-key="@col.Data" data-value="@text">
                                @if (col.RenderName == "__status")
                                {
                                    <span class="tms-dt-status @StatusClass(text)">@text</span>
                                }
                                else
                                {
                                    @text
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="tms-dt-empty" hidden="@(Model.Rows.Count == 0 ? null : "hidden")">@Model.EmptyMessage</div>
    <div class="tms-dt-footer">
        <div class="tms-dt-info"></div>
        <div class="tms-dt-pages"></div>
    </div>
</div>
