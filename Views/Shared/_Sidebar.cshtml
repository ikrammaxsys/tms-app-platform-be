        // END OF SIDEBAR SETUP

        // FIXED SIDEBAR SETUP
        // COMMENT OUT SIDEBAR SETUP ABOVE AND USE THIS BLOCK FOR FIXED SIDEBAR
         var dummySidebarUi = document.getElementById("ui-sidebar");
         fetch("@sidebarItemsUrl")
           .then(function (response) { return response.json(); })
          .then(function (data) {
              var stringData = JSON.stringify(data);
             dummySidebarUi.setAttribute("ui-data", stringData);
         })
         .catch(function (error) {
              console.log("Dummy sidebar error loading", error);
         });
        // END OF FIXED SIDEBAR SETUP

        var shell = document.getElementById('sidebar-shell');
        if (!shell) return;
        var pb = (shell.getAttribute('data-path-base') || window.appConfig?.baseUrl || '').replace(/\/$/, '');
        if (!pb) return;
        shell.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            var raw = a.getAttribute('href');
            if (!raw || raw.startsWith('#') || raw.toLowerCase().startsWith('javascript:')) return;
            try {
                var u = new URL(raw, window.location.href);
                if (u.origin !== window.location.origin) return;
                var path = u.pathname || '';
                if (path === pb || path.startsWith(pb + '/')) return;
                if (path.startsWith('/')) {
                    e.preventDefault();
                    window.location.assign(pb + path + u.search + u.hash);
                }
            } catch (_) { /* ignore */ }
        }, true);

    })();
</script>
