@model tms_template_net8.Models.ViewModels.ApplicationDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    var statusClass = Model.Status.ToLowerInvariant() switch
    {
        "warning" => "warning",
        "down" => "down",
        _ => "healthy"
    };
    var maxDrift = Model.VersionDrift.DefaultIfEmpty().Max(v => v?.ServerCount ?? 1);
    if (maxDrift < 1) maxDrift = 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/deploywatch.css" asp-append-version="true" />
}

<div class="dw-page dw-detail" id="dw-detail">
    <div class="dw-detail-top">
        <a class="dw-back" href="@Url.Action("Index", "Home")">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            Back to Overview
        </a>
    </div>

    <header class="dw-detail-header">
        <div class="dw-detail-title-row">
            <span class="dw-avatar dw-avatar-lg" style="background:@Model.AvatarColor">@Model.Initial</span>
            <div class="dw-detail-title">
                <div class="dw-detail-name-line">
                    <h1>@Model.Name</h1>
                    <span class="dw-status @statusClass"><span class="dw-dot @statusClass"></span>@Model.Status</span>
                    @if (Model.HasVersionDrift)
                    {
                        <span class="dw-badge warning">Version drift</span>
                    }
                </div>
                <p class="dw-detail-subtitle">@Model.Type · @Model.Environment · @Model.Runtime</p>
            </div>
        </div>

        <dl class="dw-meta-grid">
            <div><dt>Version</dt><dd class="dw-version">@Model.Version</dd></div>
            <div><dt>Environment</dt><dd>@Model.Environment</dd></div>
            <div><dt>Provider</dt><dd>@Model.Owner</dd></div>
            <div><dt>Repository</dt><dd>
                @if (!string.IsNullOrWhiteSpace(Model.RepositoryUrl) && Model.RepositoryUrl != "#")
                {
                    <a class="dw-repo-link" href="@Model.RepositoryUrl" target="_blank" rel="noopener noreferrer">Repo</a>
                }
                else
                {
                    <span>-</span>
                }
            </dd></div>
            <div><dt>Commit</dt><dd>@Model.CurrentDeployment.Commit</dd></div>
            <div><dt>Last Deployed</dt><dd>@Model.CurrentDeployment.Released</dd></div>
        </dl>

        <div class="dw-detail-actions">
            <button type="button" class="dw-btn-secondary" disabled title="Not available yet">Deploy History</button>
            <button type="button" class="dw-btn-secondary" disabled title="Not available yet">Logs</button>
            <button type="button" class="dw-btn-secondary" disabled title="Not available yet">Metrics</button>
            <button type="button" class="dw-btn-secondary" disabled title="Not available yet">Restart</button>
            <button type="button" class="dw-btn-secondary" disabled title="Not available yet">Configuration</button>
        </div>
    </header>

    <nav class="dw-tabs" role="tablist" aria-label="Application sections">
        <button type="button" class="dw-tab active" role="tab" aria-selected="true" data-tab="overview">Overview</button>
        <button type="button" class="dw-tab" role="tab" aria-selected="false" data-tab="servers">Servers</button>
        <button type="button" class="dw-tab dw-tab-unavailable" role="tab" aria-selected="false" data-tab="deployments" data-unavailable="true">Deployments</button>
        <button type="button" class="dw-tab dw-tab-unavailable" role="tab" aria-selected="false" data-tab="performance" data-unavailable="true">Performance</button>
        <button type="button" class="dw-tab dw-tab-unavailable" role="tab" aria-selected="false" data-tab="configuration" data-unavailable="true">Configuration</button>
        <button type="button" class="dw-tab dw-tab-unavailable" role="tab" aria-selected="false" data-tab="logs" data-unavailable="true">Logs</button>
    </nav>

    @* ===== Overview ===== *@
    <section class="dw-tab-panel active" data-panel="overview">
        <div class="dw-detail-grid">
            <div class="dw-detail-main">              
                <article class="dw-card dw-panel">
                    <h2>Today</h2>
                    <div class="dw-timeline-hours">
                        @foreach (var h in Model.TodayTimeline)
                        {
                            <span>@h.HourLabel</span>
                        }
                    </div>
                    <div class="dw-timeline-blocks" aria-label="Hourly health timeline">
                        @foreach (var h in Model.TodayTimeline)
                        {
                            var seg = h.Status.Equals("Down", StringComparison.OrdinalIgnoreCase) ? "down" : "healthy";
                            <span class="dw-timeline-seg @seg" title="@h.HourLabel:00 — @h.Status"></span>
                        }
                    </div>
                </article>

                <article class="dw-card dw-panel">
                    <div class="dw-panel-head">
                        <h2>30-Day Availability</h2>
                        <strong class="dw-avail-pct">@Model.Health.Availability</strong>
                    </div>
                    <div class="dw-status-strip" aria-label="30-day availability">
                        @foreach (var day in Model.AvailabilityDays)
                        {
                            var dayClass = day.Status.ToLowerInvariant() switch
                            {
                                "down" => "down",
                                "partial" => "partial",
                                _ => "healthy"
                            };
                            <span class="dw-status-box @dayClass" title="@day.Label — @day.Status"></span>
                        }
                    </div>
                    <div class="dw-status-strip-meta">
                        <span>@Model.AvailabilityDays.FirstOrDefault()?.Label</span>
                        <span>@Model.AvailabilityDays.LastOrDefault()?.Label</span>
                    </div>
                    <div class="dw-legend">
                        <span><i class="dw-swatch healthy"></i> Operational</span>
                        <span><i class="dw-swatch partial"></i> Partial outage</span>
                        <span><i class="dw-swatch down"></i> Major outage</span>
                    </div>
                </article>

                <article class="dw-card dw-panel">
                    <h2>Deployment Summary</h2>
                    <dl class="dw-kv dw-kv-2">
                        <div><dt>Current Version</dt><dd class="dw-version">@Model.CurrentDeployment.Version</dd></div>
                        <div><dt>Released</dt><dd>@Model.CurrentDeployment.Released</dd></div>
                        <div><dt>Commit</dt><dd><code>@Model.CurrentDeployment.Commit</code></dd></div>
                        <div><dt>Branch</dt><dd>@Model.CurrentDeployment.Branch</dd></div>
                        <div><dt>Built By</dt><dd>@Model.CurrentDeployment.BuiltBy</dd></div>
                        <div><dt>Deployed By</dt><dd>@Model.CurrentDeployment.DeployedBy</dd></div>
                        <div><dt>Deployment Duration</dt><dd>@Model.CurrentDeployment.Duration</dd></div>
                    </dl>
                </article>
            </div>

            <aside class="dw-detail-side">
                <article class="dw-card dw-panel">
                    <h2>Endpoints</h2>
                    <ul class="dw-endpoints">
                        @foreach (var ep in Model.Endpoints)
                        {
                            <li>
                                <div>
                                    <strong>@ep.Name</strong>
                                    <div class="dw-endpoint-path"><span class="dw-method">@ep.Method</span> @ep.Path</div>
                                    <div class="dw-muted-sm">Last checked @ep.LastChecked</div>
                                </div>
                                <div class="dw-endpoint-right">
                                    <span class="dw-status @(ep.StatusCode.StartsWith("2") ? "healthy" : "down")">@ep.StatusCode</span>
                                    @if (!string.IsNullOrEmpty(ep.ActionLabel))
                                    {
                                        <a href="#" class="dw-link-btn">@ep.ActionLabel</a>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </article>
            </aside>
        </div>
    </section>

    @* ===== Servers ===== *@
    <section class="dw-tab-panel" data-panel="servers" hidden>
        <article class="dw-card dw-panel"
                 id="dw-servers"
                 data-group-id="@Model.ApplicationGroupId"
                 data-app-id="@Model.Id"
                 data-current-version="@Model.Version"
                 data-endpoint="@Url.Content($"~/api/application-groups/{Model.ApplicationGroupId}/applications")">
            <div class="dw-panel-head">
                <div>
                    <h2>Servers</h2>
                    <p class="dw-panel-desc">Every server running this application — spot deployment drift instantly.</p>
                </div>
                <div class="dw-alert-banner warning compact" data-servers-drift hidden></div>
            </div>
            <div class="dw-table-wrap">
                <table class="dw-table">
                    <thead>
                        <tr>
                            <th>Server</th>
                            <th>Environment</th>
                            <th>Version</th>
                            <th>Commit</th>
                            <th>Last Deployment</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody data-servers-body>
                        <tr data-servers-state>
                            <td colspan="7" class="dw-muted-sm">Loading servers…</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </article>
    </section>

    @* ===== Deployments / Performance / Configuration / Logs (not available yet) ===== *@
    <section class="dw-tab-panel" data-panel="deployments" hidden>
        <article class="dw-card dw-panel dw-unavailable">
            <h2>Deployments</h2>
            <p>Not available yet.</p>
            <p class="dw-muted-sm">Deployment history and rollback will be added in a future release.</p>
        </article>
    </section>

    <section class="dw-tab-panel" data-panel="performance" hidden>
        <article class="dw-card dw-panel dw-unavailable">
            <h2>Performance</h2>
            <p>Not available yet.</p>
            <p class="dw-muted-sm">CPU, memory, latency, and request metrics will be added later.</p>
        </article>
    </section>

    <section class="dw-tab-panel" data-panel="configuration" hidden>
        <article class="dw-card dw-panel dw-unavailable">
            <h2>Configuration</h2>
            <p>Not available yet.</p>
            <p class="dw-muted-sm">Environment variables and runtime configuration will be added later.</p>
        </article>
    </section>

    <section class="dw-tab-panel" data-panel="logs" hidden>
        <article class="dw-card dw-panel dw-unavailable">
            <h2>Logs</h2>
            <p>Not available yet.</p>
            <p class="dw-muted-sm">Integrated application logs will be added later.</p>
        </article>
    </section>
</div>

@section Scripts {
    <script src="~/js/deploywatch-detail.js" asp-append-version="true"></script>
}
