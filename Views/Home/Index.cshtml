@model tms_template_net8.Models.ViewModels.DeployWatchOverviewViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Overview";
    var appsJson = JsonSerializer.Serialize(Model.Applications.Select(a => new
    {
        id = a.Id,
        name = a.Name,
        type = a.Type,
        initial = a.Initial,
        avatarColor = a.AvatarColor,
        server = a.Server,
        environment = a.Environment,
        version = a.Version,
        status = a.Status,
        uptime = a.Uptime,
        lastDeployment = a.LastDeployment,
        deployedBy = a.DeployedBy
    }));
    var servers = Model.Applications.Select(a => a.Server).Distinct().OrderBy(s => s).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/deploywatch.css" asp-append-version="true" />
}

<script type="application/json" id="dw-apps-data">@Html.Raw(appsJson)</script>
<div class="dw-page" id="dw-overview" data-detail-url="@Url.Action("Application", "Home")">
    <div class="dw-header">
        <div>
            <h1>Overview</h1>
            <p>Central overview of applications, servers, health, and operations</p>
        </div>
        <div class="dw-header-controls">
            <div class="dw-control">
                <span id="dw-last-updated">Last updated: @Model.LastUpdated.ToString("hh:mm:ss tt")</span>
                <button type="button" class="dw-icon-btn" id="dw-refresh" title="Refresh" aria-label="Refresh">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                        <path d="M21 3v6h-6" />
                    </svg>
                </button>
            </div>
            <div class="dw-control">
                <span>Auto refresh:</span>
                <select id="dw-auto-refresh" aria-label="Auto refresh interval">
                    <option value="30" selected>30s</option>
                    <option value="60">60s</option>
                    <option value="0">Off</option>
                </select>
            </div>
            <div class="dw-control">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
                <span>@Model.DateRangeLabel</span>
            </div>
        </div>
    </div>

    <div class="dw-stats">
        <div class="dw-stat-card">
            <div>
                <p class="dw-stat-label">Applications</p>
                <p class="dw-stat-value">@Model.Summary.ApplicationsTotal</p>
                <span class="dw-stat-meta"><span class="dw-dot healthy"></span>@Model.Summary.ApplicationsHealthy Healthy</span>
            </div>
            <span class="dw-stat-icon blue" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/></svg>
            </span>
        </div>
        <div class="dw-stat-card">
            <div>
                <p class="dw-stat-label">Servers</p>
                <p class="dw-stat-value">@Model.Summary.ServersTotal</p>
                <span class="dw-stat-meta"><span class="dw-dot healthy"></span>@Model.Summary.ServersOnline Online</span>
            </div>
            <span class="dw-stat-icon green" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/><path d="M7 7h.01M7 17h.01"/></svg>
            </span>
        </div>
        <div class="dw-stat-card">
            <div>
                <p class="dw-stat-label">Total Uptime (Avg)</p>
                <p class="dw-stat-value">@Model.Summary.AvgUptime</p>
                <span class="dw-stat-meta">
                    Last 30 days
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>
                </span>
            </div>
            <span class="dw-stat-icon purple" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l2-7 4 14 2-7h6"/></svg>
            </span>
        </div>
        <div class="dw-stat-card">
            <div>
                <p class="dw-stat-label">Alerts</p>
                <p class="dw-stat-value">@Model.Summary.AlertsCount</p>
                <span class="dw-stat-meta"><a href="#">View all alerts &rarr;</a></span>
            </div>
            <span class="dw-stat-icon red" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 7h18s-3 0-3-7"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            </span>
        </div>
    </div>

    <div class="dw-body">
        <section class="dw-card dw-apps">
            <div class="dw-apps-toolbar">
                <h2>Applications</h2>
                <div class="dw-apps-actions">
                    <select class="dw-select" id="dw-status-filter" aria-label="Filter by status">
                        <option value="all">All Status</option>
                        <option value="healthy">Healthy</option>
                        <option value="warning">Warning</option>
                        <option value="down">Down</option>
                    </select>
                    <select class="dw-select" id="dw-server-filter" aria-label="Filter by server">
                        <option value="all">All Servers</option>
                        @foreach (var server in servers)
                        {
                            <option value="@server">@server</option>
                        }
                    </select>
                    <a class="dw-btn-primary" href="@Url.Action("Create", "ApplicationManagement")" id="dw-add-app">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                        Add Application
                    </a>
                </div>
            </div>

            <div class="dw-search-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="search" id="dw-search" class="dw-search" placeholder="Search applications..." />
            </div>

            <div class="dw-table-wrap">
                <table class="dw-table">
                    <thead>
                        <tr>
                            <th>Application</th>
                            <th>Server</th>
                            <th>Version</th>
                            <th>Status</th>
                            <th>Uptime</th>
                            <th>Last Deployment</th>
                        </tr>
                    </thead>
                    <tbody id="dw-apps-tbody"></tbody>
                </table>
            </div>

            <div class="dw-pagination">
                <div class="dw-pagination-info" id="dw-page-info"></div>
                <div class="dw-page-btns" id="dw-page-btns"></div>
            </div>
        </section>

        <aside class="dw-side">
            <section class="dw-card dw-side-card">
                <div class="dw-side-header">
                    <h3>Server available</h3>
                    <a href="#">View all</a>
                </div>
                <ul class="dw-server-list">
                    @foreach (var server in Model.Servers)
                    {
                        var statusClass = server.Status.Equals("Warning", StringComparison.OrdinalIgnoreCase) ? "warning" : "healthy";
                        <li class="dw-server-item">
                            <span class="dw-dot @statusClass"></span>
                            <div class="dw-server-meta">
                                <strong>@server.Name</strong>
                                <span>@server.Environment</span>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/deploywatch-overview.js" asp-append-version="true"></script>
}
