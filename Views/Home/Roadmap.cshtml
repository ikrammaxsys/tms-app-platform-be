@model tms_template_net8.Models.ViewModels.RoadmapViewModel
@{
    ViewData["Title"] = "Roadmap";
}

@section Styles {
    <link rel="stylesheet" href="~/css/deploywatch.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/roadmap.css" asp-append-version="true" />
}

<div class="dw-page rm-page">
    <div class="dw-header">
        <div>
            <h1>Roadmap</h1>
            <p>TMS Dev Platform features — ideas, work in progress, and what has shipped</p>
        </div>
        <div class="dw-header-controls">
            <div class="dw-control">
                <span>@Model.Ideas.Count Ideas</span>
                <span>·</span>
                <span>@Model.InProgress.Count In Progress</span>
                <span>·</span>
                <span>@Model.Shipped.Count Shipped</span>
            </div>
        </div>
    </div>

    <div class="rm-board">
        <section class="rm-column ideas">
            <header class="rm-column-head">
                <h2>Ideas</h2>
                <span class="rm-count">@Model.Ideas.Count</span>
            </header>
            <div class="rm-cards">
                @foreach (var item in Model.Ideas)
                {
                    <article class="rm-card">
                        @if (!string.IsNullOrWhiteSpace(item.Tag))
                        {
                            <span class="rm-tag">@item.Tag</span>
                        }
                        <h3>@item.Title</h3>
                        <p>@item.Description</p>
                    </article>
                }
            </div>
        </section>

        <section class="rm-column in-progress">
            <header class="rm-column-head">
                <h2>In Progress</h2>
                <span class="rm-count">@Model.InProgress.Count</span>
            </header>
            <div class="rm-cards">
                @foreach (var item in Model.InProgress)
                {
                    <article class="rm-card">
                        @if (!string.IsNullOrWhiteSpace(item.Tag))
                        {
                            <span class="rm-tag">@item.Tag</span>
                        }
                        <h3>@item.Title</h3>
                        <p>@item.Description</p>
                    </article>
                }
            </div>
        </section>

        <section class="rm-column shipped">
            <header class="rm-column-head">
                <h2>Shipped</h2>
                <span class="rm-count">@Model.Shipped.Count</span>
            </header>
            <div class="rm-cards">
                @foreach (var item in Model.Shipped)
                {
                    <article class="rm-card">
                        @if (!string.IsNullOrWhiteSpace(item.Tag))
                        {
                            <span class="rm-tag">@item.Tag</span>
                        }
                        <h3>@item.Title</h3>
                        <p>@item.Description</p>
                    </article>
                }
            </div>
        </section>
    </div>
</div>
