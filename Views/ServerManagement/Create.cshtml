@{
    ViewData["Title"] = "Create Server";
    var envUrl = Url.Content("~/data/environment-options.json");
    var ieUrl = Url.Content("~/data/internal-external-options.json");
    var providerUrl = Url.Content("~/data/provider-options.json");
}
<form id="serverCreateForm" method="post">
    <ui-page-section title="Create Server">
        <ui-form-card title="Server Details">
            <ui-form-content>
                <div class="row mt-2">
                    <div class="col-6">
                        <ui-text-input name="Domain" id="Domain" required label="Domain" type="text" placeholder="e.g. tms-eapp.webapp.toray"></ui-text-input>
                    </div>
                    <div class="col-6">
                        <ui-text-input name="IpAddress" id="IpAddress" required label="IP Address" type="text" placeholder="e.g. 10.188.9.136"></ui-text-input>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <ui-dropdown name="Environment" required id="Environment" label="Environment" value="Live" ui-source="@envUrl" placeholder="Select environment"></ui-dropdown>
                    </div>
                    <div class="col-6">
                        <ui-dropdown name="InternalExternal" required id="InternalExternal" label="Internal / External" value="Internal" ui-source="@ieUrl" placeholder="Select"></ui-dropdown>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <ui-text-input name="Country" id="Country" label="Country" type="text" placeholder="e.g. JP"></ui-text-input>
                    </div>
                    <div class="col-6">
                        <ui-dropdown name="Provider" id="Provider" label="Provider" value="AWS" ui-source="@providerUrl" placeholder="Select provider"></ui-dropdown>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6"></div>
                    <div class="col-6" style="float:right">
                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <ui-button label="Back" type="button" id="btnCancel" class="btn-right"></ui-button>
                            <ui-button label="Submit" type="button" id="btnSubmit" class="btn-right" data-bs-toggle="modal" data-bs-target="#submit-confirmation-modal"></ui-button>
                        </div>
                    </div>
                </div>
            </ui-form-content>
        </ui-form-card>
    </ui-page-section>
</form>
@await Html.PartialAsync("~/Views/Shared/_ConfirmationModal.cshtml", new tms_template_net8.Models.ViewModels.ConfirmationModalViewModel { ModalId = "submit-confirmation-modal", Message = "Are you sure you want to create this server?", ConfirmButtonId = "btnConfirm" })
@section Scripts {
    <script>
        window.serverManagementCreateConfig = { urls: { index: '@Url.Action("Index", "ServerManagement")' } };
    </script>
    <script src="~/js/apiClient.js" asp-append-version="true"></script>
    <script type="module" src="~/ServerManagement/js/create.js" asp-append-version="true"></script>
}
