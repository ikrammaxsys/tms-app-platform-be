@{
    var id = ViewBag.Id as int? ?? 0;
    ViewData["Title"] = "Application Detail";
}
<div class="row g-0 px-3 tr-listing-header">
    <div class="col-sm-6 align-self-center">
        <p class="text-muted m-0 tr-listing-header-title">Application Detail</p>
    </div>
</div>
<div style="border-top:1px solid #F0F0F0; margin-top:-1px" class="tr-btm-line"></div>
<div class="page-container px-3 overflow-auto">
    <div class="tr-btm-btn-margin">
        <div id="detailLoading" class="text-center py-5 text-muted">Loading...</div>
        <div id="detailContent" style="display: none;">
            <div class="card mt-3 mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h6 class="card-title text-muted m-0 p-0">Application Details</h6>
                        <a id="btnEdit" href="#" class="btn btn-sm btn-primary">Edit</a>
                    </div>
                    <hr />
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Name <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailName">-</p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Group <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailGroup">-</p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Version <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailVersion">-</p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Commit <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailCommit">-</p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Status <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailStatus">-</p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Last Deployment <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailLastDeployment">-</p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">App URL <span style="float:right">:</span></p></div><div class="col-sm-6"><p class="m-0"><a id="detailAppUrl" href="#" target="_blank" rel="noopener noreferrer">-</a></p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Repository URL <span style="float:right">:</span></p></div><div class="col-sm-6"><p class="m-0"><a id="detailRepositoryUrl" href="#" target="_blank" rel="noopener noreferrer">-</a></p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Server <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailServer">-</p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Environment <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailEnvironment">-</p></div></div>
                    <div class="row mt-2"><div class="col-sm-2"><p class="text-muted">Server IP <span style="float:right">:</span></p></div><div class="col-sm-4"><p class="m-0" id="detailServerIp">-</p></div></div>
                </div>
            </div>
            <div class="row row-cols-auto justify-content-between g-1 tr-btm-btn-area tr-btm-size" style="padding-right: 20px;">
                <div><button id="btnDelete" type="button" class="btn btn-sm btn-danger mx-1" data-bs-toggle="modal" data-bs-target="#confirmation-modal">Delete</button></div>
                <div class="col"><button id="btnBack" type="button" class="btn btn-sm btn-secondary mx-1">Back</button></div>
            </div>
        </div>
        <div id="detailError" class="text-center py-5 text-danger" style="display: none;">Failed to load application.</div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Shared/_ConfirmationModal.cshtml", new tms_template_net8.Models.ViewModels.ConfirmationModalViewModel { ModalId = "confirmation-modal", Message = "Are you sure to delete this application?", ConfirmButtonId = "btnConfirmDelete", UseSmallButtons = false })
@section Scripts {
    <script>
        window.applicationManagementDetailConfig = {
            applicationId: @id,
            urls: {
                index: '@Url.Action("Index", "ApplicationManagement")',
                edit: '@Url.Action("Edit", "ApplicationManagement", new { id })'
            }
        };
    </script>
    <script src="~/js/apiClient.js" asp-append-version="true"></script>
    <script type="module" src="~/ApplicationManagement/js/detail.js" asp-append-version="true"></script>
}
