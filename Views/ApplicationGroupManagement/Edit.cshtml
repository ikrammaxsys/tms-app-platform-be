@{
    var id = ViewBag.Id as int? ?? 0;
    ViewData["Title"] = "Edit Application Group";
}
<div id="editLoading" class="text-center py-5 text-muted">Loading...</div>
<form id="applicationGroupEditForm" method="post" style="display: none;">
    <ui-page-section title="Edit Application Group">
        <ui-form-card title="Group Details">
            <ui-form-content>
                <div class="row mt-2">
                    <div class="col-6">
                        <ui-text-input name="Name" id="Name" required label="Group Name" type="text" placeholder="e.g. ACL Stack"></ui-text-input>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6"></div>
                    <div class="col-6" style="float:right">
                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <ui-button label="Back" type="button" id="btnCancel" class="btn-right"></ui-button>
                            <ui-button label="Update" type="button" id="btnSubmit" class="btn-right" data-bs-toggle="modal" data-bs-target="#edit-confirmation-modal"></ui-button>
                        </div>
                    </div>
                </div>
            </ui-form-content>
        </ui-form-card>
    </ui-page-section>
</form>
<div id="editError" class="text-center py-5 text-danger" style="display: none;">Failed to load application group.</div>
@await Html.PartialAsync("~/Views/Shared/_ConfirmationModal.cshtml", new tms_template_net8.Models.ViewModels.ConfirmationModalViewModel { ModalId = "edit-confirmation-modal", Message = "Are you sure you want to update this application group?", ConfirmButtonId = "btnConfirmUpdate" })
@section Scripts {
    <script>
        window.applicationGroupManagementEditConfig = {
            groupId: @id,
            urls: {
                index: '@Url.Action("Index", "ApplicationGroupManagement")',
                detail: '@Url.Action("Detail", "ApplicationGroupManagement", new { id })'
            }
        };
    </script>
    <script src="~/js/apiClient.js" asp-append-version="true"></script>
    <script type="module" src="~/ApplicationGroupManagement/js/edit.js" asp-append-version="true"></script>
}
